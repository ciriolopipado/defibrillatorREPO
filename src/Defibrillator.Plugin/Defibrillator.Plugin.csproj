<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>Defibrillator</AssemblyName>
    <Version>0.1.1</Version>
    <GameReferencePath Condition="'$(GameReferencePath)' == ''">$(MSBuildThisFileDirectory)../../local-libs</GameReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Defibrillator.Core/Defibrillator.Core.csproj" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameReferencePath)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GameReferencePath)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameReferencePath)/0Harmony.dll" Private="false" />
    <Reference Include="REPOLib" HintPath="$(GameReferencePath)/REPOLib.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(GameReferencePath)/PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(GameReferencePath)/PhotonRealtime.dll" Private="false" />
    <Reference Include="Photon3Unity3D" HintPath="$(GameReferencePath)/Photon3Unity3D.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameReferencePath)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameReferencePath)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GameReferencePath)/UnityEngine*.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameReferencePath)/Assembly-CSharp.dll')" Text="Supply R.E.P.O. 0.5.1 Managed DLLs in local-libs, or set GameReferencePath. Do not commit game DLLs." />
    <Error Condition="!Exists('$(GameReferencePath)/REPOLib.dll')" Text="Supply REPOLib 4.3.0 in GameReferencePath." />
    <Error Condition="!Exists('$(GameReferencePath)/BepInEx.dll')" Text="Supply BepInEx.dll and 0Harmony.dll from BepInExPack 5.4.2305 in GameReferencePath." />
  </Target>
</Project>
